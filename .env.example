# ─────────────────────────────────────────────────────────────────────────────
# FeedBoard — Backend (Express) environment.
# Copy to `.env` and fill in. Never commit real secrets. `.env` is gitignored.
# See DEPLOYMENT.md (frontend repo) for the full production guide.
# Values shown are examples/defaults — replace the REQUIRED ones.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# App port. In production PM2 (ecosystem.config.js) sets this per environment
# (production=4562, staging=4561); this .env value is the fallback for `node app.js`.
APP_PORT=4560
# Reverse-proxy hops in front of the app (Nginx = 1). Needed for correct client
# IP + rate limiting + secure cookies behind HTTPS.
TRUST_PROXY_HOPS=1
# PM2 worker count in cluster mode ("max" = one per core; a number to pin).
PM2_INSTANCES=max

# ── Database (MySQL) — REQUIRED ──────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=feedboard
DB_PASSWORD=CHANGE_ME
DB_NAME=feedboard_db
# Optional pool tuning (sensible defaults exist):
# DB_CONNECTION_LIMIT=15
# DB_MAX_IDLE=10
# MAX_CONNECTIONS=15

# ── Auth (JWT) — REQUIRED ────────────────────────────────────────────────────
# Signing secret for the API's own access tokens. Generate: openssl rand -hex 48
SECRET_ACCESS_TOKEN=CHANGE_ME
# Token lifetime (e.g. 15m, 1h, 7d).
ACCESS_TOKEN_EXPIRE=7d

# ── Frontend origin — REQUIRED ───────────────────────────────────────────────
# Public URL of the Next.js app; used for links in emails, Stripe redirect URLs,
# and (with ROOT_DOMAIN) CORS. e.g. https://feedboardapp.com
FRONTEND_URL=http://localhost:3000
# Root domain (no protocol), used by scripts + as the CORS base. e.g. feedboardapp.com
ROOT_DOMAIN=localhost:3000
# Optional: comma-separated extra origins allowed by CORS. The app already allows
# FRONTEND_URL and any subdomain of ROOT_DOMAIN; add others here if needed.
# CORS_EXTRA_ORIGINS=https://admin.feedboardapp.com

# ── Billing provider ─────────────────────────────────────────────────────────
# Which payment provider is ACTIVE: `paddle` (Merchant of Record — default) or
# `stripe` (kept dormant/hidden; usable later). Both implementations coexist.
BILLING_PROVIDER=paddle

# ── Paddle — the active provider (Merchant of Record) ────────────────────────
# From your Paddle dashboard (Developer Tools). Use SANDBOX values while testing,
# switch PADDLE_ENV to `production` with production keys/prices/webhook to go live.
PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_sdbx_CHANGE_ME
# Notification-destination secret for webhook verification (starts pdl_ntfset_).
PADDLE_WEBHOOK_SECRET=pdl_ntfset_CHANGE_ME
# Price IDs (pri_...) created by `node scripts/paddle-setup.js` (monthly + yearly).
PADDLE_PRICE_PRO=pri_CHANGE_ME
PADDLE_PRICE_PRO_YEARLY=pri_CHANGE_ME
PADDLE_PRICE_BUSINESS=pri_CHANGE_ME
PADDLE_PRICE_BUSINESS_YEARLY=pri_CHANGE_ME

# Billing scheduler — applies plan changes Paddle cannot defer itself (yearly →
# monthly). MONEY-CRITICAL: with it disabled such a change never takes effect and
# the customer is billed for another full year. Cluster-safe (MySQL advisory lock),
# so it is safe to leave on with PM2 running one worker per core. Defaults are fine.
# BILLING_SCHEDULER=off            # disable entirely
# BILLING_SCHEDULER_MINUTES=30     # tick interval (default 30)
# BILLING_SCHEDULER_LEAD_HOURS=6   # how long before renewal a due change may apply

# ── Stripe — dormant alternative provider (kept for a later switch) ──────────
# Only used when BILLING_PROVIDER=stripe. Use LIVE keys in production; test in staging.
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
# Price IDs created by `node scripts/stripe-setup.js` (monthly + yearly per plan).
STRIPE_PRICE_PRO=price_CHANGE_ME
STRIPE_PRICE_PRO_YEARLY=price_CHANGE_ME
STRIPE_PRICE_BUSINESS=price_CHANGE_ME
STRIPE_PRICE_BUSINESS_YEARLY=price_CHANGE_ME

# ── Email — REQUIRED (pick ONE provider) ─────────────────────────────────────
# Option 1: Resend (HTTP API, best deliverability). Set this and skip SMTP.
# RESEND_API_KEY=re_CHANGE_ME
# Option 2: SMTP (e.g. Hostinger / Spaceship mailbox).
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=465
SMTP_USER=support@yourdomain.com
SMTP_PASS=CHANGE_ME
# From/reply-to shown to recipients.
MAIL_FROM=FeedBoard <support@yourdomain.com>
MAIL_REPLY_TO=support@yourdomain.com

# ── Optional tuning (safe defaults exist) ────────────────────────────────────
# JSON_BODY_LIMIT=1mb
# REQUEST_TIMEOUT_MS=30000
# HEADERS_TIMEOUT_MS=35000
# KEEPALIVE_TIMEOUT_MS=65000
# SHUTDOWN_TIMEOUT_MS=15000
# SLOW_REQUEST_MS=1000
# RATE_LIMIT_GLOBAL_MAX=600
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_EXPENSIVE_MAX=60
# RATE_LIMIT_PUBLIC_WRITE_MAX=30
# CACHE_MAX_ENTRIES=5000
# CACHE_TTL_TENANT_MS=10000
# CACHE_TTL_OFFERS_MS=30000
# MAX_ITEMS_PER_PAGE=100
# MAX_PAGE_NUMBER=10000
# PUBLIC_MAX_ITEMS_PER_PAGE=100
# PUBLIC_MAX_OFFSET=10000
